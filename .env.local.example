# ==============================================================================
# AutoAI Edit — Safe Local Development Environment Template (Step 2A)
#
# DO NOT COMMIT REAL SECRETS. Copy this file to .env or apps/api/.env.local for local testing.
# All endpoints and credentials point strictly to isolated local Docker containers.
# ==============================================================================

NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000
TRUST_PROXY=false

# ── Isolated Local Database (PostgreSQL 16 in Docker) ────────────────────────
DATABASE_URL=postgresql://autoedit:autoedit_dev_password@localhost:5432/autoedit_local?schema=public

# ── Isolated Local Cache & Queue Broker (Redis 7 in Docker) ──────────────────
REDIS_URL=redis://localhost:6379

# ── Local Development Authentication Secrets ──────────────────────────────────
# Development-only placeholder secrets. DO NOT USE IN PRODUCTION.
JWT_SECRET=dev-only-local-insecure-jwt-secret-do-not-use-in-production-1234567890
JWT_EXPIRES_IN=7d
INTEGRATION_ENCRYPTION_SECRET=dev-only-local-32-byte-encryption-secret-012345678901234567890

# ── Isolated Local Object Storage (MinIO in Docker) ───────────────────────────
# MinIO S3 API: http://127.0.0.1:9002
# MinIO Web Console: http://127.0.0.1:9003
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minio_local_admin
AWS_SECRET_ACCESS_KEY=minio_local_secret_key
S3_BUCKET=autoedit-local
S3_ENDPOINT=http://127.0.0.1:9002
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=3600

# ── AI Provider Configuration (Deterministic Fallback / No Paid API) ─────────
# Uses local deterministic mock/fallback provider. No paid Anthropic/OpenAI keys.
AI_PROVIDER=fallback
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ── Local Speech-to-Text Sidecar (Faster-Whisper in Docker) ──────────────────
WHISPER_URL=http://localhost:9000
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ENABLE_DIARIZATION=false
HUGGINGFACE_TOKEN=

# ── Local Render Worker Configuration ─────────────────────────────────────────
RENDER_WORK_DIR=C:\autoedit-local-work
BACKGROUND_MUSIC_PATH=
BACKGROUND_MUSIC_VOLUME=0.1
MAX_UPLOAD_BYTES=5368709120
ANALYSIS_CONCURRENCY=1
ANALYSIS_LOCK_DURATION_MS=900000
RENDER_CONCURRENCY=1
RENDER_TIMEOUT_MS=3600000
MEMORY_THRESHOLD_MB=1536

# ── Optional Integrations (Disabled for Local Dev) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
